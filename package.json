    "cors": "^2.8.6",
    "dexie": "^4.4.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.14",
    "pg": "^8.22.0",
    "pinia": "^3.0.4",
    "three": "^0.182.0",
    "three-mesh-bvh": "^0.9.10",
    "vue": "^3.5.28",
    "vue-router": "^5.1.0",
    "zod": "^4.4.3"
