# 复制为 server/.env 后按需修改。
# 注意：仓库 .gitignore 含 `.env.*`，所以本文件特意命名为 env.example（无点前缀）以便纳入版本管理。

NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=8038

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=deipss
PGPASSWORD=<your-postgres-password>
PGDATABASE=railway_signal_runner

# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-strong-secret>
JWT_ACCESS_TTL=7200
JWT_REFRESH_TTL=2592000
PASSWORD_RESET_TTL=1800
BCRYPT_ROUNDS=10
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

ALLOW_TEACHER_SELF_REGISTER=false
EXPOSE_RESET_TOKEN=false
CORS_ORIGINS=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MODELS=/path/to/ollama/models
# AI_DEFAULT_MODEL=qwen3:14b
# AI_MODEL_ALLOWLIST=
# AI_MODEL_DENYLIST=
